# ローカルの PostgreSQL（UNIXソケット接続）の例
DATABASE_URL=postgresql://localhost/agri?host=/var/run/postgresql
# docker compose (infra/docker-compose.yml) を使う場合
# DATABASE_URL=postgresql://pesticide:pesticide@localhost:5433/pesticide_platform

# FAMIC 農薬登録情報（登録基本部・登録適用部）の ZIP/CSV の取得元。パスまたはURLをカンマ区切りで指定
# （公開URL・ファイル構成は運用前に要確認）
FAMIC_SOURCES=
