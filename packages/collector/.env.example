DATABASE_URL=postgresql://localhost/agri?host=/var/run/postgresql

# PDF・画像の保存先（API と同じディレクトリを指定する）
STORAGE_DIR=/var/lib/pesticide-platform/storage

# 検索プロバイダ: none（手動登録URLのみ巡回） / google_cse / brave
SEARCH_PROVIDER=none
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_API_KEY=

# bot の識別子（robots.txt の判定と User-Agent に使用）。連絡先URLを入れておく
COLLECTOR_USER_AGENT=PesticidePlatformBot/0.1 (+https://example.com/bot)
# 1回の実行で処理する農薬数（検索APIの1日の上限 ÷ 2クエリ を目安に）
COLLECTOR_BATCH_SIZE=10
# 実行スケジュール（既定: 毎時15分）
COLLECTOR_CRON=15 * * * *
# 再巡回の間隔（日）
COLLECTOR_RECHECK_DAYS=30
# 同一ホストへのアクセス間隔（ミリ秒）
COLLECTOR_HOST_INTERVAL_MS=3000
# このスコア以上は自動採用（未満は管理画面で人が確認）
AUTO_APPROVE_SCORE=90
