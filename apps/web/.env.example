# ブラウザに埋め込む値。`VITE_` で始まるものだけが公開される JS に入る（秘密情報は書かない）。
# `pnpm dev` と Firebase Hosting 用ビルドの両方がこのファイルを読む。
# Hosting の本番ビルドだけ上書きするときは `.env.production` に同じキーを書く。
# デプロイ先プロジェクトだけ上書きするときは `.env.<プロジェクトID>` に書く（firebase deploy 時に最優先）。

VITE_API_BASE_URL=http://localhost:8790

# firebase deploy のプロジェクト ID または .firebaserc のエイリアス。空なら .firebaserc の default。
FIREBASE_PROJECT_ID=
