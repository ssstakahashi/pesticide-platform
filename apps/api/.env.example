PORT=8790
DATABASE_URL=postgresql://localhost/agri?host=/var/run/postgresql

# Firebase Hosting の Web アプリや外部アプリのオリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:5173

# 認証モード: required（本番） / disabled（ローカル開発のみ）
AUTH_MODE=required
# システム間連携用の APIキー（Bearer トークン, カンマ区切り）
API_KEYS=
# Firebase Auth の ID トークンを検証する場合のプロジェクトID
FIREBASE_PROJECT_ID=

# 検索系 GET エンドポイントのレートリミット（IP単位・1分あたり）
RATE_LIMIT_PER_MINUTE=120

# bot が収集した PDF・画像の保存先（packages/collector の STORAGE_DIR と同じ場所）
STORAGE_DIR=/home/s-takahashi/development/pesticide-platform/storage
# 保存ファイルの署名付きURL用の鍵（32文字以上, 本番必須）。例: openssl rand -hex 32
FILE_URL_SECRET=
# 署名付きURLの有効期間（秒）
FILE_URL_TTL_SECONDS=3600
