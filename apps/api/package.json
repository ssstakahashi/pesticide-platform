{
  "name": "@pesticide/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "tsx scripts/dump-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@pesticide/api-contract": "workspace:*",
    "@pesticide/collector": "workspace:*",
    "@pesticide/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
